<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Hospital.presentation.AcercaDe.View">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="825" height="653"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="b93d7" binding="imagePanel" layout-manager="GridLayoutManager" row-count="3" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="973fc" class="javax.swing.JLabel" binding="imageHospital">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <icon value="images/hospital.jpg"/>
              <text value=""/>
            </properties>
          </component>
          <component id="b556c" class="javax.swing.JLabel" binding="nomHospital">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <opaque value="false"/>
              <text value="Hospital pokémon"/>
            </properties>
          </component>
          <component id="cc29f" class="javax.swing.JLabel" binding="ContacNumber">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Número de contacto: 7278-5169"/>
            </properties>
          </component>
          <component id="89a08" class="javax.swing.JLabel" binding="direc">
            <constraints>
              <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Dirección: 50 metros norte de la entrada de la UNA, facultad de ciencias exactas y naturales"/>
            </properties>
          </component>
          <hspacer id="bad9d">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <hspacer id="8de5">
            <constraints>
              <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
    </children>
  </grid>
</form>
